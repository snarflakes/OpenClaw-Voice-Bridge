{
  "id": "openclaw-voice-bridge",
  "name": "OpenClaw Voice Bridge",
  "description": "Receives WAV audio paths from snarling, transcribes via OpenAI, and injects the transcript into the agent session. Snarling owns recording; this plugin owns transcription and delivery.",
  "categories": ["voice"],
  "setup": {
    "providers": [
      {
        "id": "openai",
        "envVars": ["OPENAI_API_KEY"]
      }
    ]
  },
  "contracts": {
    "tools": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "transcriptionModel": {
        "type": "string",
        "description": "OpenAI transcription model (default: gpt-4o-mini-transcribe)",
        "default": "gpt-4o-mini-transcribe"
      },
      "debugEnabled": {
        "type": "boolean",
        "description": "Enable debug logging to debugLogPath (default: false)",
        "default": false
      },
      "debugLogPath": {
        "type": "string",
        "description": "Debug log file path (default: /tmp/voice-bridge-debug.log)",
        "default": "/tmp/voice-bridge-debug.log"
      }
    }
  }
}